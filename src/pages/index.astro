---
// 知验台分发链介绍站（Persuade 单页，add-bench-chain-website tasks 2.1-2.5）。
// 红线（PRODUCT.md / .impeccable/surfaces/bench-site.md 约束）：
//  - 实时概况带数字 MUST 活拉自同源匿名概览端点 /api/public/overview；失败如实报因，
//    不回退旧值、不摆拍、不做 localStorage 缓存（首查与「缓存命中」无两口径）。
//  - 静态事实数字全部在 Facts 白名单内（出处见 bench-site.md），以 <data> + as_of 口径标注。
//  - 概览端点未 live 前水合区以报因态呈现（诚实降级），文案不写完成态断言。
import Layout from "../layouts/layout.astro";

// C3 分发契约真证据锚（白名单事实 5：legal v2 已发布，2026-11-12；v1 为 2026-11-06 联调冒烟）。
// 仅作叙事锚与签名运动「一锚贯之」的对账常量，不参与任何「实时数字」渲染。
const ANCHOR_DIGEST = "5897354d";
const ENDPOINT = "https://bench.finddatatech.cloud/api/public/overview";
---

<Layout>
  <main>
    <!-- ── 首屏：层 0 论点（task 2.1） ── -->
    <section class="hero">
      <h1>竞争不在模型，<br />在知识的沉淀与复利。</h1>
      <p class="lede">
        知验台（bench）在法条锚定的语料上评测知识，把评测出的知识以<b>本体</b>形态版本化发布；
        柏讯（wire）的消费端接入能力已交付（生产订阅尚未开启）。<b>沉淀与发布这一段在产</b>——
        页面数字活拉自匿名概览端点并带 as_of，失败如实报因，不摆拍。
      </p>
    </section>

    <!-- ── 链路三节图（task 2.1）：① 沉淀 → ② 发布 → ③ 消费，③ 锚 C3 digest 真证据 ── -->
    <section class="chain" aria-label="知识分发链三节">
      <article class="node" id="node-1">
        <span class="no">01 · 知识沉淀</span>
        <h2>评测出的知识</h2>
        <p>
          32,275 部法规目录、43 类合同种子条款之上，判官评审环
          （rubric × criteria）驱动 <span class="fact-num">generate → fill → evaluate → improve</span>
          自愈迭代——知识不是攒出来的，是被评测磨出来的。
        </p>
      </article>
      <span class="arrow" aria-hidden="true">→</span>
      <article class="node" id="node-2">
        <span class="no">02 · 本体发布</span>
        <h2>版本化发布契约</h2>
        <p>
          四类知识资产（本体 / RAG / 评测尺子 / 微调数据）共享同一套身份与发布机制：
          按 domain/version/digest 发布，gold/silver/bronze 质量分层随行。
        </p>
      </article>
      <span class="arrow" aria-hidden="true">→</span>
      <article class="node" id="node-3">
        <span class="no">03 · 柏讯消费</span>
        <h2>跨命名空间落库</h2>
        <p>
          柏讯的消费端接入能力已交付：拉取客户端、本地快照落库（按 digest 幂等）、
          只读投影三件齐备。生产订阅尚未开启——打开后按域定时拉最新发布版。
        </p>
        <p class="anchor-line">
          <span class="tag">C3 知识分发契约 · 真证据（as_of 2026-11-06）</span>
          legal v2 已发布 · digest <b>{ANCHOR_DIGEST}</b>
        </p>
      </article>
    </section>

    <!-- ── 实时概况带（task 2.1/2.4 水合数据区）：SSR 只放连接状态，无任何摆拍数字 ── -->
    <section class="overview" aria-label="已发布本体实时概况">
      <div class="band-head">
        <h2>发布面现在有什么</h2>
        <span class="asof" id="asof">as_of 未取得 · 数字取自匿名概览端点，非本页硬编</span>
      </div>
      <div id="overview-data">
        <p class="status" id="overview-status">正在连接匿名概览端点…</p>
      </div>
    </section>

    <!-- ── 证据区（task 2.2，门 A） ── -->
    <section class="evidence" id="evidence" aria-label="评测与资产证据">
      <p class="kicker">DOOR A · 门 A 决策评估者的证据面</p>
      <h2>知识是怎么被评测、怎么被发布、怎么被消费的</h2>
      <p class="section-lede">
        每一条静态数字都带 as_of 口径与可指名的出处（见页脚归属）；发布面的活数字由上方概况带供，
        两处不混用。
      </p>

      <div class="assets">
        <article class="asset">
          <span class="no">ASSET 01</span>
          <h3>本体</h3>
          <p>领域数据语义层：概念、关系与分层质量档位一体成账。</p>
        </article>
        <article class="asset">
          <span class="no">ASSET 02</span>
          <h3>RAG 知识资产</h3>
          <p>内核知识单元承载 chunk / 条款，法律域存量即活的检索资产。</p>
        </article>
        <article class="asset">
          <span class="no">ASSET 03</span>
          <h3>评测资产（尺子）</h3>
          <p>rubric × criteria 逐条判定 PASS/FAIL 并给理由，量尺本身也是资产。</p>
        </article>
        <article class="asset">
          <span class="no">ASSET 04</span>
          <h3>微调数据</h3>
          <p>评测与语料沉淀出的训练对，走同一套身份与发布机制。</p>
        </article>
      </div>

      <div class="evidence-blocks">
        <article class="eblock">
          <h3>质量分层：gold / silver / bronze</h3>
          <p>四类资产共享同一套质量档位；分层随本体版本一起发布，消费方按档位决定用法。</p>
          <div class="tierline">
            <span class="tier gold">gold</span>
            <span class="tier silver">silver</span>
            <span class="tier bronze">bronze</span>
          </div>
          <small class="src-note">出处：knowledge-platform-blueprint §二（四类知识资产，一套内核）＋ add-bench-public-overview-tier 概览载荷口径。</small>
        </article>
        <article class="eblock">
          <h3>判官评审环与五岗舰队</h3>
          <p>评测端以自愈管线迭代至达标；本体建设由五岗舰队完成，全部写操作走提案制、人工确认后落库。</p>
          <div class="loop" aria-label="评审环流程">
            <span class="stage">generate</span> → <span class="stage">fill</span> →
            <span class="stage">evaluate</span> → <span class="stage">improve</span>
          </div>
          <small class="src-note">
            出处：law-bench README 能力表（自愈管线）；fleet-packs/blueprints/ontology-builder（本体盘账员 → 建模师 → 纪律校验闸 → 提案员 → 台账主编，全只读＋提案制）。
          </small>
        </article>
      </div>

      <div class="evidence-blocks">
        <article class="eblock">
          <h3>语料底座</h3>
          <p>
            法规目录 <data class="fact-num" value="32296">32,296</data> 部（as_of 2026-11-12 现网
            <code>law_catalog.laws</code>），合同 <data class="fact-num" value="66">66</data> 类母版模板、
            其中 <data class="fact-num" value="41">41</data> 类带种子条款（<code>data/clause_seeds/</code>）——
            法条锚定，条级引用可定位。
          </p>
          <small class="src-note">出处：三数均现网/仓内实测（2026-11-12）——法规=<code>law_catalog.laws</code> 行数 32,296；母版=<code>list_contract_types()</code> 66 类；种子=<code>data/clause_seeds/*.yaml</code> 41 份。旧记「32,275（2026-09 刷新）」与「43 类」已随本轮订正。</small>
        </article>
        <article class="eblock">
          <h3>机器可及</h3>
          <p>
            bench MCP server 对外提供 <data class="fact-num" value="54">54</data> 个工具（as_of 2026-11-12 现网 <code>tools/list</code> 口径），
            覆盖语料检索、评测与本体面；发布面另有匿名概览窄口（见门 B）。
          </p>
          <small class="src-note">出处：现网 <code>tools/list</code> 实枚举 54（2026-11-12 复核）；README 旧记 37 已随本轮订正。</small>
        </article>
      </div>
    </section>

    <!-- ── 动作区（task 2.3，两扇门） ── -->
    <section class="doors" aria-label="两条行动路径">
      <p class="kicker">TWO DOORS · 两扇门</p>
      <h2>接下来去哪</h2>
      <div class="door-grid">
        <article class="door">
          <span class="who">DOOR A · 决策评估者</span>
          <h3>核对证据，再下判断</h3>
          <p>
            证据面就在上方：四类资产、质量分层、评审环与语料底座，每个数字带 as_of 与出处；
            发布面的活数字以端点 as_of 为准，两处口径不混。
          </p>
          <a class="btn ghost" href="#evidence">回看证据面</a>
        </article>
        <article class="door">
          <span class="who">DOOR B · 智能体开发者</span>
          <h3>当场接一次端点</h3>
          <p>匿名概览端点（上线中——端点未开放时下方概况带会如实报因），无需凭据，返回已发布本体版本、计数、分层分布与 as_of：</p>
          <div class="endpoint-row">
            <code class="endpoint-chip" id="endpoint-chip">{ENDPOINT}</code>
            <button class="btn" type="button" id="copy-btn" data-endpoint={ENDPOINT}>复制端点</button>
          </div>
          <pre class="snippet" aria-label="curl 试令">curl -fsS {ENDPOINT}</pre>
          <p class="auth-note">
            <b>认证口径：</b>概览端点匿名可读（设计契约已冻结，部署收尾中）；全量访问（语料正文、评测操作、本体全量拉取）需 API key，
            或经 MCP 网关使用 bench MCP server 的 54 个工具（网关入口同样需凭据：匿名请求返回 <code>Authentication required</code>）——
            <a href="https://mcp.finddatatech.cloud" rel="noopener">mcp.finddatatech.cloud</a>。
          </p>
        </article>
      </div>
    </section>

    <footer>
      <span>知验台 bench · 寻数旗下识律线 —— 评测出知识，以本体发布，供多端消费。</span>
      <span class="mono">bench.finddatatech.cloud</span>
    </footer>
  </main>

  <script define:vars={{ ANCHOR_DIGEST }}>
    // ── 水合脚本（tasks 2.4，design D3）──
    // 契约：fetch 同源 /api/public/overview（生产由 Caddy 同源反代到 bench 公共 pod 同路径）；
    // 渲染版本表（domain/version/digest/published_at）、计数、gold/silver/bronze 分层、as_of；
    // 失败 → 数据区报因卡（状态码 + reason），绝不显示假数据或旧缓存；不做 localStorage 缓存。
    // 字段名沿 law-bench add-bench-public-overview-tier spec：
    //   { as_of, ontology_versions: [{ domain_key, version, digest, published_at,
    //       counts: { 实体数, 关系数, gold/silver/bronze 分层 } }], totals }
    // spec 未冻结 counts 内层键名，读取器做容错归一；渲染值全部原样来自端点，无一处构造数。
    (function () {
      var PATH = "/api/public/overview";
      var $data = document.getElementById("overview-data");
      var $asof = document.getElementById("asof");
      var $node3 = document.getElementById("node-3");

      function esc(s) {
        return String(s == null ? "" : s).replace(/[&<>"]/g, function (c) {
          return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c];
        });
      }
      function num(v) {
        return typeof v === "number" && isFinite(v) ? v.toLocaleString("en-US") : null;
      }
      // 逐键取值（define:vars 脚本不转译，避免 ?? 运算符在旧内核上的解析风险）
      function pick(obj) {
        for (var i = 1; i < arguments.length; i++) {
          var v = obj ? obj[arguments[i]] : undefined;
          if (v !== undefined && v !== null) return v;
        }
        return undefined;
      }
      // counts 容错归一：spec 只钉语义（实体数/关系数/分层），键名以端点为准
      function readCounts(c) {
        c = c && typeof c === "object" ? c : {};
        var t = c.tiers || c.by_tier || c.tier_distribution || {};
        return {
          entities: num(pick(c, "entities", "entity_count", "entities_total")),
          relations: num(pick(c, "relations", "relation_count", "relations_total")),
          gold: num(t.gold), silver: num(t.silver), bronze: num(t.bronze),
        };
      }
      function tierChip(kind, v) {
        return v == null
          ? ""
          : '<span class="tier ' + kind + '">' + kind + " " + esc(v) + "</span>";
      }

      // 叙事锚是**短锚**（8 位，见首屏 `legal v2 · digest 5897354d`），端点返回的是
      // 64 位全串。全等比较永远不会成立，绿标与行高亮会结构性假死——2026-11-12 线上
      // 实测 {live:0, anchorHit:0} 而表格已渲染。判据必须是"以短锚开头"。
      function anchorMatches(digest) {
        var d = String(digest || "").toLowerCase();
        return d.length >= ANCHOR_DIGEST.length && d.indexOf(ANCHOR_DIGEST) === 0;
      }

      function renderOverview(t) {
        var versions = Array.isArray(t.ontology_versions) ? t.ontology_versions : [];
        var rows = versions.map(function (v) {
          var c = readCounts(v.counts);
          var tiers =
            tierChip("gold", c.gold) + " " + tierChip("silver", c.silver) + " " + tierChip("bronze", c.bronze);
          var matched = anchorMatches(v.digest);
          return (
            "<tr" + (matched ? ' class="anchor-hit"' : "") + ">" +
            '<td class="mono">' + esc(pick(v, "domain_key") || "—") + "</td>" +
            '<td class="mono">' + esc(pick(v, "version") || "—") + "</td>" +
            '<td class="mono">' + esc(pick(v, "digest") || "—") + "</td>" +
            '<td class="mono">' + esc(pick(v, "published_at") || "—") + "</td>" +
            "<td>" + esc(c.entities ?? "—") + "</td>" +
            "<td>" + esc(c.relations ?? "—") + "</td>" +
            "<td>" + (tiers.trim() || "—") + "</td>" +
            "</tr>"
          );
        });
        var table = versions.length
          ? '<div class="table-wrap"><table class="versions">' +
            "<thead><tr><th>DOMAIN</th><th>VERSION</th><th>DIGEST</th><th>PUBLISHED_AT</th>" +
            "<th>实体</th><th>关系</th><th>分层</th></tr></thead><tbody>" +
            rows.join("") + "</tbody></table></div>"
          : '<p class="status">端点可达，但未列出任何已发布本体版本（以上即端点实况，非本页判断）。</p>';

        var totals = t.totals && typeof t.totals === "object" ? t.totals : {};
        var chips = '<span class="stat">已发布本体版本 <b>' + versions.length + "</b> 个</span>";
        var tEnt = num(pick(totals, "entities", "entity_count", "entities_total"));
        var tRel = num(pick(totals, "relations", "relation_count", "relations_total"));
        if (tEnt != null) chips += '<span class="stat">实体合计 <b>' + esc(tEnt) + "</b></span>";
        if (tRel != null) chips += '<span class="stat">关系合计 <b>' + esc(tRel) + "</b></span>";

        $data.innerHTML = '<div class="stats">' + chips + "</div>" + table;
        $asof.textContent = "as_of " + (pick(t, "as_of") || "未取得") + " · 取自实时概览端点，非本页硬编";

        // 签名运动「一锚贯之」：叙事锚 digest 与端点返回对上才亮，失败态两处都不亮
        var hit = versions.some(function (v) {
          return anchorMatches(v.digest);
        });
        if (hit && $node3) $node3.classList.add("live");
      }

      function renderFail(status, reason) {
        var head =
          status == null
            ? "端点未响应 · 网络错误"
            : "端点响应异常 · HTTP " + esc(status);
        $data.innerHTML =
          '<div class="fail-card" role="alert">' +
          '<p class="fail-title">' + head + "</p>" +
          "<p>本页不摆拍：概况带只渲染端点真响应。" + esc(reason || "原因未说明。") + "</p>" +
          "</div>";
        $asof.textContent = "as_of 未取得 · 端点未返回有效数据";
      }

      fetch(PATH, { headers: { Accept: "application/json" } })
        .then(function (res) {
          if (!res.ok) {
            // Caddy 反代失败透传非 200（503 带 {"error","reason"}；429 带 Retry-After）
            return res
              .json()
              .catch(function () { return null; })
              .then(function (body) {
                var reason =
                  (body && (body.reason || body.error)) ||
                  (res.status === 429 && res.headers.get("Retry-After")
                    ? "请求过于频繁，Retry-After " + res.headers.get("Retry-After") + " 秒后重试。"
                    : "") ||
                  res.statusText ||
                  "服务暂不可用。";
                renderFail(res.status, reason);
              });
          }
          return res.json().then(
            function (t) {
              if (!t || typeof t !== "object") {
                renderFail(200, "端点返回了非对象载荷，本页拒绝渲染。");
                return;
              }
              renderOverview(t);
            },
            function () {
              renderFail(200, "端点响应不是合法 JSON，本页拒绝渲染。");
            }
          );
        })
        .catch(function (err) {
          renderFail(null, err && err.message ? err.message : "连接未建立。");
        });
    })();

    // ── 门 B：复制端点按钮（clipboard + 旧浏览器回退） ──
    (function () {
      var btn = document.getElementById("copy-btn");
      if (!btn) return;
      var timer = null;
      btn.addEventListener("click", function () {
        var text = btn.getAttribute("data-endpoint");
        function done(ok) {
          btn.textContent = ok ? "已复制" : "复制失败，请手动选择";
          btn.classList.toggle("copied", !!ok);
          clearTimeout(timer);
          timer = setTimeout(function () {
            btn.textContent = "复制端点";
            btn.classList.remove("copied");
          }, 1600);
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(
            function () { done(true); },
            function () { done(fallback(text)); }
          );
        } else {
          done(fallback(text));
        }
        function fallback(t) {
          var ta = document.createElement("textarea");
          ta.value = t;
          ta.style.position = "fixed";
          ta.style.opacity = "0";
          document.body.appendChild(ta);
          ta.select();
          var ok = false;
          try { ok = document.execCommand("copy"); } catch (e) { ok = false; }
          document.body.removeChild(ta);
          return ok;
        }
      });
    })();
  </script>
</Layout>
